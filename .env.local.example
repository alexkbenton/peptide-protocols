# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. These same vars must also be set in
# Vercel → Settings → Environment Variables for production.

# ── Klaviyo (newsletter capture) ──────────────
# Scopes needed: subscriptions:write, profiles:write, lists:write
KLAVIYO_PRIVATE_API_KEY=pk_your-private-api-key-here
# Optional — omit to use the account default opt-in settings
KLAVIYO_LIST_ID=your-list-id-here
# Optional — defaults to 2026-07-15
KLAVIYO_API_REVISION=2026-07-15

# ── Calendly (consultation booking) ───────────
# Must be NEXT_PUBLIC_ prefixed: the widget runs client-side.
# Until this is set, /consultation shows the waitlist fallback.
# Note: Calendly rewrites this slug when you change the event duration,
# so re-check it here and in Vercel after editing the event.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/forgeamino/45min
